# ---------------------------------------------------------------------------
# OwnMed server — environment template.
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# HTTP server
PORT=4000
NODE_ENV=development

# Neon PostgreSQL.
# Use the *pooled* connection string from the Neon dashboard:
#   Project -> Connection Details -> Connection string -> "Pooled connection"
# The host contains `-pooler`; keep `?sslmode=require` on the end.
DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/ownmed?sslmode=require

# Neon requires SSL. Set to false only for a local Postgres without TLS.
DATABASE_SSL=true

# Optional. Where `npm test` writes. The suites create *@ownmed.test accounts
# and delete them afterwards; every table cascades from `users`, so nothing
# else is touched. Left empty, tests fall back to DATABASE_URL — convenient on
# a dev database, but a dedicated branch or database is the safer target.
TEST_DATABASE_URL=

# Authentication.
# Long random string used to sign access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Access-token lifetime (jsonwebtoken `expiresIn` format).
JWT_ACCESS_EXPIRES_IN=15m

# Refresh-token lifetime, in days.
REFRESH_TOKEN_EXPIRES_DAYS=30

# Email delivery (Resend) — used for password-reset codes.
# Get a key from https://resend.com. `from` must be a verified sender address.
RESEND_API_KEY=
RESEND_FROM=OwnMed <onboarding@resend.dev>

# Report storage (Cloudflare R2) — holds uploaded lab reports, scans and
# prescriptions. Optional at boot: the server starts without these and the
# /reports routes answer 503 until all four are set.
# Create a bucket in the Cloudflare dashboard, then an API token with
# Object Read & Write on it. The endpoint is on the bucket's settings page and
# looks like https://<account-id>.r2.cloudflarestorage.com.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional. Only set this if the bucket is served through a custom domain or a
# CDN in front of it, e.g. https://files.ownmed.example. Left empty (the
# default) the bucket stays private and downloads use short-lived signed URLs.
R2_PUBLIC_URL=

# App release info — served by GET /app/version so an installed build can tell
# whether a newer one exists. Both optional: leaving LATEST_APP_VERSION empty
# announces nothing and the app shows no update notice, which is the right state
# for a fresh clone and for the window before a first release. Announcing a
# release is setting the version here and redeploying; there is no table and no
# migration involved.
LATEST_APP_VERSION=
# Where the update notice sends the user, e.g. a Play Store listing. May be
# empty while there is no listing yet — the notice then reads as information
# with nothing to tap.
STORE_URL=

# Browser origins allowed to call the API, comma-separated, e.g.
#   CORS_ORIGINS=https://app.ownmed.example,https://ownmed.example
# CORS is a browser rule: the mobile app sends no Origin and is never affected,
# so leaving this empty only denies cross-origin *web* clients. In development
# every origin is allowed regardless of this value.
CORS_ORIGINS=

# Set to true only when a reverse proxy (nginx, Render, Fly, a load balancer)
# sits in front of this process. Requests then arrive from the proxy's address,
# so without this every caller shares one rate-limit bucket — but with it set
# while nothing rewrites X-Forwarded-For, a client can forge its own IP and
# skip the limit. Off unless you know a proxy is there.
TRUST_PROXY=false
